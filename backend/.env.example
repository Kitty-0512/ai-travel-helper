# DeepSeek API Key（前往 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API Base URL（默认官方，可换成代理）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=1.0
DEEPSEEK_MESSAGE_CHAR_BUDGET=24000

# Agent timeouts (seconds)
PLANNER_TIMEOUT=45
EXECUTOR_TIMEOUT=120
FINALIZE_TIMEOUT=45
SSE_IDLE_TIMEOUT=300

# 高德地图 Web 服务 Key（前往 console.amap.com 获取）
AMAP_API_KEY=your-amap-web-api-key-here
AMAP_BASE_URL=https://restapi.amap.com/v3
MAP_PROVIDER=amap
WEATHER_PROVIDER=amap
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=1
PROVIDER_ENABLE_FALLBACK=true
PROVIDER_CACHE_TTL_SECONDS=1800

# 本后端 API 鉴权 Key（前端调用时需携带此 Key）
# 生产环境必须替换为至少 24 位强随机字符串
API_SECRET_KEY=change-me-to-a-random-string
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# 服务端口
PORT=8000

# 环境
ENV=development

# ── Agent Memory（docker compose up -d 后可用）──
MEMORY_ENABLED=true
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_helper
MEMORY_REDIS_TTL_SECONDS=604800
MEMORY_TOP_K=8
EMBEDDING_DIM=1536
# Redis/PG 不可用时使用进程内兜底（非持久化，便于本地开发）
MEMORY_FALLBACK_INPROCESS=true
# 可选：OpenAI 兼容 embedding；留空则使用本地 hash embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ── Agent Trace ──
TRACE_ENABLED=true
TRACE_FALLBACK_INPROCESS=true

# ── Rate Limit ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_DEFAULT=30/minute

# ── MCP Travel Server ──
MCP_ENABLED=true
MCP_SERVER_COMMAND=python
MCP_SERVER_SCRIPT=../travel-mcp-server/server.py
MCP_TIMEOUT=20
MCP_TOOL_LOG_PATH=logs/tool_calls.jsonl
